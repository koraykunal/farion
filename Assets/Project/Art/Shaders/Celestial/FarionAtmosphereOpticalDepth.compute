#pragma kernel CSMain

RWTexture2D<float4> Result;
int textureSize;
int numOutScatteringSteps;
float atmosphereRadius;
float densityFalloff;
float mieDensityFalloff;
float ozonePeakHeight;
float ozoneBandWidth;

#define PI 3.14159265358979323846

#include "FarionCelestialRaycast.hlsl"

float3 DensityAtPoint(float2 densitySamplePoint)
{
    float planetRadius = 1.0;
    float2 planetCentre = 0.0;
    float heightAboveSurface = length(densitySamplePoint - planetCentre) - planetRadius;
    float height01 = saturate(heightAboveSurface / max(atmosphereRadius - planetRadius, 0.0001));

    float rayleigh = exp(-height01 * densityFalloff) * (1.0 - height01);
    float mie = exp(-height01 * mieDensityFalloff) * (1.0 - height01);

    float ozoneOffset = (height01 - ozonePeakHeight) / max(ozoneBandWidth, 0.0001);
    float ozone = exp(-ozoneOffset * ozoneOffset) * (1.0 - height01);

    return float3(rayleigh, mie, ozone);
}

float3 OpticalDepth(float2 rayOrigin, float2 rayDirection, float rayLength)
{
    int numOpticalDepthPoints = numOutScatteringSteps;
    float2 densitySamplePoint = rayOrigin;
    float stepSize = rayLength / (numOpticalDepthPoints - 1);
    float3 opticalDepth = 0.0;

    for (int i = 0; i < numOpticalDepthPoints; i++)
    {
        opticalDepth += DensityAtPoint(densitySamplePoint) * stepSize;
        densitySamplePoint += rayDirection * stepSize;
    }

    return opticalDepth;
}

[numthreads(8, 8, 1)]
void CSMain(uint2 id : SV_DispatchThreadID)
{
    uint safeTextureSize = (uint)textureSize;
    if (id.x >= safeTextureSize || id.y >= safeTextureSize)
    {
        return;
    }

    const float planetRadius = 1.0;
    float2 uv = (float2)id / (float)safeTextureSize;
    float height01 = uv.y;
    float y = -2.0 * uv.x + 1.0;
    float x = sin(acos(y));
    float2 direction = float2(x, y);

    float2 inPoint = float2(0.0, lerp(planetRadius, atmosphereRadius, height01));
    float rayLength = FarionRaySphere(0.0, atmosphereRadius, float3(inPoint, 0.0), float3(direction, 0.0)).y;

    float3 outScattering = OpticalDepth(
        inPoint + direction * 0.0001,
        direction,
        max(rayLength - 0.0002, 0.0));

    Result[id.xy] = float4(outScattering, 1.0);
}
