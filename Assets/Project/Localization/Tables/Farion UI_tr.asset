  m_TableData:
  - m_Id: 1222115328
    m_Localized: AYARLAR
    m_Metadata:
      m_Items: []
  - m_Id: 1259864064
    m_Localized: "ER\u0130\u015E\u0130LEB\u0130L\u0130RL\u0130K"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058368
    m_Localized: "ARAY\xDCZ"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058371
    m_Localized: Dil
    m_Metadata:
      m_Items: []
  - m_Id: 1264058372
    m_Localized: "Men\xFClerde ve sistem mesajlar\u0131nda kullan\u0131lacak dili
      se\xE7."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058373
    m_Localized: "Aray\xFCz \xF6l\xE7e\u011Fi"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058374
    m_Localized: "Men\xFClerin ve operasyon g\xF6stergelerinin boyutunu art\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058375
    m_Localized: "Azalt\u0131lm\u0131\u015F hareket"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058376
    m_Localized: "\xC7o\u011Fu aray\xFCz ge\xE7i\u015Fini anl\u0131k durum de\u011Fi\u015Fimleriyle
      de\u011Fi\u015Ftir."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058377
    m_Localized: "Altyaz\u0131lar"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058378
    m_Localized: "Konu\u015Fmalar\u0131 ve \xF6nemli telsiz ileti\u015Fimini g\xF6ster."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058379
    m_Localized: "Altyaz\u0131 boyutu"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058380
    m_Localized: "Diyalog altyaz\u0131lar\u0131nda kullan\u0131lacak okuma boyutunu
      belirle."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058381
    m_Localized: "\u0130ngilizce"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058382
    m_Localized: "T\xFCrk\xE7e"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058383
    m_Localized: "A\xE7\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058384
    m_Localized: "Kapal\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058385
    m_Localized: Standart
    m_Metadata:
      m_Items: []
  - m_Id: 1264058386
    m_Localized: "B\xFCy\xFCk"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058387
    m_Localized: "GER\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058388
    m_Localized: "\u0130PTAL"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058389
    m_Localized: "\xC7IKI\u015E"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058390
    m_Localized: Devam et
    m_Metadata:
      m_Items: []
  - m_Id: 1264058391
    m_Localized: Yeni oyun
    m_Metadata:
      m_Items: []
  - m_Id: 1264058392
    m_Localized: "Oyun y\xFCkle"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058393
    m_Localized: Ayarlar
    m_Metadata:
      m_Items: []
  - m_Id: 1264058394
    m_Localized: Jenerik
    m_Metadata:
      m_Items: []
  - m_Id: 1264058395
    m_Localized: "\xC7\u0131k\u0131\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058396
    m_Localized: Devam et
    m_Metadata:
      m_Items: []
  - m_Id: 1264058397
    m_Localized: Envanter
    m_Metadata:
      m_Items: []
  - m_Id: 1264058398
    m_Localized: Planlar
    m_Metadata:
      m_Items: []
  - m_Id: 1264058399
    m_Localized: "G\xFCnl\xFCk"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058400
    m_Localized: Gemi
    m_Metadata:
      m_Items: []
  - m_Id: 1264058401
    m_Localized: Harita
    m_Metadata:
      m_Items: []
  - m_Id: 1264058402
    m_Localized: Ayarlar
    m_Metadata:
      m_Items: []
  - m_Id: 1264058403
    m_Localized: Kaydet
    m_Metadata:
      m_Items: []
  - m_Id: 1264058404
    m_Localized: "Ana men\xFCye d\xF6n"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058405
    m_Localized: "Oyundan \xE7\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058406
    m_Localized: DURAKLATMA MENÜSÜ
    m_Metadata:
      m_Items: []
  - m_Id: 1264058407
    m_Localized: ENVANTER
    m_Metadata:
      m_Items: []
  - m_Id: 1264058408
    m_Localized: YUVA
    m_Metadata:
      m_Items: []
  - m_Id: 1264058409
    m_Localized: "E\u015EYA DETAYI"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058410
    m_Localized: "BO\u015E YUVA"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058411
    m_Localized: "Toplanan malzeme ve bile\u015Fenler i\xE7in kullan\u0131labilir."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058412
    m_Localized: "M\u0130KTAR"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058413
    m_Localized: "ARA\u015ETIRMA ALANI"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058414
    m_Localized: "S\u0130STEM GE\xC7\u0130\u015E\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058415
    m_Localized: SEFER HAZIRLANIYOR
    m_Metadata:
      m_Items: []
  - m_Id: 1264058416
    m_Localized: "G\xF6rev ortam\u0131 y\xFCkleniyor"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058417
    m_Localized: "ANA MEN\xDCYE D\xD6N\xDCL\xDCYOR"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058418
    m_Localized: "Komuta aray\xFCz\xFC haz\u0131rlan\u0131yor"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058419
    m_Localized: Sil
    m_Metadata:
      m_Items: []
  - m_Id: 1264058420
    m_Localized: Kaydet
    m_Metadata:
      m_Items: []
  - m_Id: 1264058421
    m_Localized: "Y\xFCkle"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058422
    m_Localized: SEFER KAYDI
    m_Metadata:
      m_Items: []
  - m_Id: 1264058423
    m_Localized: "SEFERE D\xD6N"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058424
    m_Localized: OYUNU KAYDET
    m_Metadata:
      m_Items: []
  - m_Id: 1264058425
    m_Localized: "OYUNU Y\xDCKLE"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058426
    m_Localized: "Mevcut sefer durumu i\xE7in bir yuva se\xE7."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058427
    m_Localized: "Sefere devam etmek i\xE7in uyumlu bir kay\u0131t se\xE7."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058428
    m_Localized: KAYIT TAR\u0130H\u0130
    m_Metadata:
      m_Items: []
  - m_Id: 1264058429
    m_Localized: "KAYIT S\xDCR\xDCM\xDC"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058430
    m_Localized: "KULLANILAMAZ"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058431
    m_Localized: "Bu kay\u0131t y\xFCklenemiyor."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058432
    m_Localized: "Kaydetme kullan\u0131lam\u0131yor."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058433
    m_Localized: ANA KAYIT
    m_Metadata:
      m_Items: []
  - m_Id: 1264058434
    m_Localized: "MANUEL KAYIT {0:00}"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058435
    m_Localized: "KAYIT VER\u0130S\u0130 YOK"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058436
    m_Localized: HAZIR
    m_Metadata:
      m_Items: []
  - m_Id: 1264058437
    m_Localized: YEDEK
    m_Metadata:
      m_Items: []
  - m_Id: 1264058438
    m_Localized: UYUMSUZ
    m_Metadata:
      m_Items: []
  - m_Id: 1264058439
    m_Localized: HASARLI
    m_Metadata:
      m_Items: []
  - m_Id: 1264058440
    m_Localized: "BO\u015E"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058441
    m_Localized: "Y\xDCKLEMEYE HAZIR"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058442
    m_Localized: "KURTARMA YEDE\u011E\u0130 HAZIR"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058443
    m_Localized: "KAYIT S\xDCR\xDCM\xDC DESTEKLENM\u0130YOR"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058444
    m_Localized: "KAYIT VER\u0130S\u0130 OKUNAMADI"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058445
    m_Localized: "YEN\u0130 KAYIT \u0130\xC7\u0130N UYGUN"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058446
    m_Localized: "Bu kay\u0131t mevcut oyun s\xFCr\xFCm\xFCyle uyumlu."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058447
    m_Localized: "Ana kay\u0131t kullan\u0131lam\u0131yor. Uyumlu kurtarma kopyas\u0131 kullan\u0131lacak."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058448
    m_Localized: "Bu kay\u0131t uyumsuz bir oyun s\xFCr\xFCm\xFCyle olu\u015Fturulmu\u015F."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058449
    m_Localized: "Kay\u0131t var ancak i\xE7eri\u011Fi ge\xE7erli de\u011Fil."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058450
    m_Localized: "Bu yuvaya hen\xFCz bir sefer kayd\u0131 yaz\u0131lmad\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058451
    m_Localized: "KAYDIN \xDCZER\u0130NE YAZ"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058452
    m_Localized: "Bu yuvadaki mevcut kay\u0131t de\u011Fi\u015Ftirilecek."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058453
    m_Localized: "\xDCZER\u0130NE YAZ"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058454
    m_Localized: "KAYDI S\u0130L"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058455
    m_Localized: "Bu kay\u0131t ve kurtarma yede\u011Fi kal\u0131c\u0131 olarak silinecek."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058456
    m_Localized: "Kaydetme ba\u015Far\u0131s\u0131z: {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058457
    m_Localized: "Oyun kaydedildi."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058458
    m_Localized: "Silme ba\u015Far\u0131s\u0131z: {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058459
    m_Localized: "Kay\u0131t silindi."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058460
    m_Localized: "Onay ekran\u0131 kullan\u0131lam\u0131yor."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058461
    m_Localized: HAZIR
    m_Metadata:
      m_Items: []
  - m_Id: 1264058462
    m_Localized: EYLEM KULLANILAMIYOR
    m_Metadata:
      m_Items: []
  - m_Id: 1264058463
    m_Localized: TAMAMLANDI
    m_Metadata:
      m_Items: []
  - m_Id: 1264058464
    m_Localized: YOK
    m_Metadata:
      m_Items: []
  - m_Id: 1264058465
    m_Localized: "AKTARIM Y\xD6N\xDC DE\u011E\u0130\u015ET\u0130R\u0130LD\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058466
    m_Localized: "E\u015EYA SE\xC7\u0130LMED\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058467
    m_Localized: "{0} {1} AKTARILDI"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058468
    m_Localized: "AKTARIM BA\u015EARISIZ"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058469
    m_Localized: "Aktar\u0131m tamamlanamad\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058470
    m_Localized: KARGO AKTARIMI
    m_Metadata:
      m_Items: []
  - m_Id: 1264058471
    m_Localized: "B\u0130R E\u015EYA SE\xC7 VE AKTAR"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058472
    m_Localized: "TAR\u0130F SE\xC7\u0130LMED\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058473
    m_Localized: "\u0130STASYON HAZIR DE\u011E\u0130L"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058474
    m_Localized: "{0} \xDCRET\u0130LD\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058475
    m_Localized: "\xDCRET\u0130M BA\u015EARISIZ"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058476
    m_Localized: "Tarif \xFCretilemedi."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058477
    m_Localized: "{0} TERM\u0130NAL\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058478
    m_Localized: "\xDCRET\u0130M TERM\u0130NAL\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058479
    m_Localized: "TAR\u0130F YOK"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058480
    m_Localized: "Bu istasyonda kullan\u0131labilir tarif yok."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058481
    m_Localized: "KULLANILAB\u0130L\u0130R TAR\u0130F YOK"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058482
    m_Localized: "G\u0130RD\u0130LER"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058483
    m_Localized: "\xC7IKTILAR"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058484
    m_Localized: "ARA\u015ETIRMA SE\xC7\u0130LMED\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058485
    m_Localized: "{0} TAMAMLANDI"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058486
    m_Localized: "ARA\u015ETIRMA BA\u015EARISIZ"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058487
    m_Localized: "Ara\u015Ft\u0131rma tamamlanamad\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058488
    m_Localized: "ARA\u015ETIRMA TERM\u0130NAL\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058489
    m_Localized: "ARA\u015ETIRMA YOK"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058490
    m_Localized: "Bu terminalde kullan\u0131labilir ara\u015Ft\u0131rma yok."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058491
    m_Localized: "KULLANILAB\u0130L\u0130R ARA\u015ETIRMA YOK"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058492
    m_Localized: "{0}  /  SEV\u0130YE {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058493
    m_Localized: "GEREKL\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058494
    m_Localized: "\u015EEMALAR"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058495
    m_Localized: YETENEKLER
    m_Metadata:
      m_Items: []
  - m_Id: 1264058496
    m_Localized: "\xDCretim Terminalini A\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058497
    m_Localized: "Ara\u015Ft\u0131rma Terminalini A\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058498
    m_Localized: "Kargo Aktar\u0131m\u0131n\u0131 A\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058499
    m_Localized: "GER\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058500
    m_Localized: "Terminali kapat"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058501
    m_Localized: "\xDCRET"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058502
    m_Localized: "Se\xE7ili malzemeleri kullan"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058503
    m_Localized: TAMAMLA
    m_Metadata:
      m_Items: []
  - m_Id: 1264058504
    m_Localized: "Gereksinimleri harca ve kilidi a\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058505
    m_Localized: "B\u0130R ADET AKTAR"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058506
    m_Localized: "Bir birim ta\u015F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058507
    m_Localized: "YI\u011EINI AKTAR"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058508
    m_Localized: "Se\xE7ili y\u0131\u011F\u0131n\u0131 ta\u015F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058509
    m_Localized: "Y\xD6N\xDC DE\u011E\u0130\u015ET\u0130R"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058510
    m_Localized: "Aktar\u0131m y\xF6n\xFCn\xFC tersine \xE7evir"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058511
    m_Localized: SES
    m_Metadata:
      m_Items: []
  - m_Id: 1264058512
    m_Localized: Ana ses
    m_Metadata:
      m_Items: []
  - m_Id: 1264058513
    m_Localized: Oyunun t\xFCm ses kar\u0131\u015F\u0131m\u0131n\u0131 kontrol et.
    m_Metadata:
      m_Items: []
  - m_Id: 1264058514
    m_Localized: M\xFCzik
    m_Metadata:
      m_Items: []
  - m_Id: 1264058515
    m_Localized: Adaptif m\xFCzik seviyesini kontrol et.
    m_Metadata:
      m_Items: []
  - m_Id: 1264058516
    m_Localized: Ortam sesi
    m_Metadata:
      m_Items: []
  - m_Id: 1264058517
    m_Localized: Uzay, atmosfer ve i\xE7 mek\xE2n ortam seslerini kontrol et.
    m_Metadata:
      m_Items: []
  - m_Id: 1264058518
    m_Localized: Efektler
    m_Metadata:
      m_Items: []
  - m_Id: 1264058519
    m_Localized: Uzay arac\u0131 ve d\xFCnya ses efektlerini kontrol et.
    m_Metadata:
      m_Items: []
  - m_Id: 1264058520
    m_Localized: Aray\xFCz sesi
    m_Metadata:
      m_Items: []
  - m_Id: 1264058521
    m_Localized: Aray\xFCz gezinme ve geri bildirim seslerini kontrol et.
    m_Metadata:
      m_Items: []
  - m_Id: 1264058522
    m_Localized: HIZ
    m_Metadata:
      m_Items: []
  - m_Id: 1264058523
    m_Localized: "\u0130N\u0130\u015E VEKT\xD6R\xDC"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058524
    m_Localized: "TAKV\u0130YE"
    m_Metadata:
      m_Items: []
