  m_TableData:
  - m_Id: 1222115328
    m_Localized: AYARLAR
    m_Metadata:
      m_Items: []
  - m_Id: 1259864064
    m_Localized: "ER\u0130\u015E\u0130LEB\u0130L\u0130RL\u0130K"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058368
    m_Localized: "ARAY\xDCZ"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058371
    m_Localized: Dil
    m_Metadata:
      m_Items: []
  - m_Id: 1264058372
    m_Localized: "Men\xFClerde ve sistem mesajlar\u0131nda kullan\u0131lacak dili
      se\xE7."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058373
    m_Localized: "Aray\xFCz \xF6l\xE7e\u011Fi"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058374
    m_Localized: "Men\xFClerin ve operasyon g\xF6stergelerinin boyutunu art\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058375
    m_Localized: "Azalt\u0131lm\u0131\u015F hareket"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058376
    m_Localized: "\xC7o\u011Fu aray\xFCz ge\xE7i\u015Fini anl\u0131k durum de\u011Fi\u015Fimleriyle
      de\u011Fi\u015Ftir."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058377
    m_Localized: "Altyaz\u0131lar"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058378
    m_Localized: "Konu\u015Fmalar\u0131 ve \xF6nemli telsiz ileti\u015Fimini g\xF6ster."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058379
    m_Localized: "Altyaz\u0131 boyutu"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058380
    m_Localized: "Diyalog altyaz\u0131lar\u0131nda kullan\u0131lacak okuma boyutunu
      belirle."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058381
    m_Localized: "\u0130ngilizce"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058382
    m_Localized: "T\xFCrk\xE7e"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058383
    m_Localized: "A\xE7\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058384
    m_Localized: "Kapal\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058385
    m_Localized: Standart
    m_Metadata:
      m_Items: []
  - m_Id: 1264058386
    m_Localized: "B\xFCy\xFCk"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058387
    m_Localized: "GER\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058388
    m_Localized: "\u0130PTAL"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058389
    m_Localized: "\xC7IKI\u015E"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058390
    m_Localized: Devam et
    m_Metadata:
      m_Items: []
  - m_Id: 1264058391
    m_Localized: Yeni oyun
    m_Metadata:
      m_Items: []
  - m_Id: 1264058392
    m_Localized: "Oyun y\xFCkle"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058393
    m_Localized: Ayarlar
    m_Metadata:
      m_Items: []
  - m_Id: 1264058394
    m_Localized: Jenerik
    m_Metadata:
      m_Items: []
  - m_Id: 1264058395
    m_Localized: "\xC7\u0131k\u0131\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058396
    m_Localized: Devam et
    m_Metadata:
      m_Items: []
  - m_Id: 1264058397
    m_Localized: Envanter
    m_Metadata:
      m_Items: []
  - m_Id: 1264058398
    m_Localized: Planlar
    m_Metadata:
      m_Items: []
  - m_Id: 1264058399
    m_Localized: "G\xFCnl\xFCk"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058400
    m_Localized: Gemi
    m_Metadata:
      m_Items: []
  - m_Id: 1264058401
    m_Localized: Harita
    m_Metadata:
      m_Items: []
  - m_Id: 1264058402
    m_Localized: Ayarlar
    m_Metadata:
      m_Items: []
  - m_Id: 1264058403
    m_Localized: Kaydet
    m_Metadata:
      m_Items: []
  - m_Id: 1264058404
    m_Localized: "Ana men\xFCye d\xF6n"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058405
    m_Localized: "Oyundan \xE7\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058406
    m_Localized: "DURAKLATMA MEN\xDCS\xDC"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058407
    m_Localized: ENVANTER
    m_Metadata:
      m_Items: []
  - m_Id: 1264058408
    m_Localized: YUVA
    m_Metadata:
      m_Items: []
  - m_Id: 1264058409
    m_Localized: "E\u015EYA DETAYI"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058410
    m_Localized: "BO\u015E YUVA"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058411
    m_Localized: "Toplanan malzeme ve bile\u015Fenler i\xE7in kullan\u0131labilir."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058412
    m_Localized: "M\u0130KTAR"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058413
    m_Localized: "ARA\u015ETIRMA ALANI"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058414
    m_Localized: "S\u0130STEM GE\xC7\u0130\u015E\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058415
    m_Localized: SEFER HAZIRLANIYOR
    m_Metadata:
      m_Items: []
  - m_Id: 1264058416
    m_Localized: "G\xF6rev ortam\u0131 y\xFCkleniyor"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058417
    m_Localized: "ANA MEN\xDCYE D\xD6N\xDCL\xDCYOR"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058418
    m_Localized: "Komuta aray\xFCz\xFC haz\u0131rlan\u0131yor"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058419
    m_Localized: Sil
    m_Metadata:
      m_Items: []
  - m_Id: 1264058420
    m_Localized: Kaydet
    m_Metadata:
      m_Items: []
  - m_Id: 1264058421
    m_Localized: "Y\xFCkle"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058422
    m_Localized: SEFER KAYDI
    m_Metadata:
      m_Items: []
  - m_Id: 1264058423
    m_Localized: "SEFERE D\xD6N"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058424
    m_Localized: OYUNU KAYDET
    m_Metadata:
      m_Items: []
  - m_Id: 1264058425
    m_Localized: "OYUNU Y\xDCKLE"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058426
    m_Localized: "Mevcut sefer durumu i\xE7in bir yuva se\xE7."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058427
    m_Localized: "Sefere devam etmek i\xE7in uyumlu bir kay\u0131t se\xE7."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058428
    m_Localized: "KAYIT TAR\u0130H\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058429
    m_Localized: "KAYIT S\xDCR\xDCM\xDC"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058430
    m_Localized: KULLANILAMAZ
    m_Metadata:
      m_Items: []
  - m_Id: 1264058431
    m_Localized: "Bu kay\u0131t y\xFCklenemiyor."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058432
    m_Localized: "Kaydetme kullan\u0131lam\u0131yor."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058433
    m_Localized: ANA KAYIT
    m_Metadata:
      m_Items: []
  - m_Id: 1264058434
    m_Localized: MANUEL KAYIT {0:00}
    m_Metadata:
      m_Items: []
  - m_Id: 1264058435
    m_Localized: "KAYIT VER\u0130S\u0130 YOK"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058436
    m_Localized: HAZIR
    m_Metadata:
      m_Items: []
  - m_Id: 1264058437
    m_Localized: YEDEK
    m_Metadata:
      m_Items: []
  - m_Id: 1264058438
    m_Localized: UYUMSUZ
    m_Metadata:
      m_Items: []
  - m_Id: 1264058439
    m_Localized: HASARLI
    m_Metadata:
      m_Items: []
  - m_Id: 1264058440
    m_Localized: "BO\u015E"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058441
    m_Localized: "Y\xDCKLEMEYE HAZIR"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058442
    m_Localized: "KURTARMA YEDE\u011E\u0130 HAZIR"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058443
    m_Localized: "KAYIT S\xDCR\xDCM\xDC DESTEKLENM\u0130YOR"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058444
    m_Localized: "KAYIT VER\u0130S\u0130 OKUNAMADI"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058445
    m_Localized: "YEN\u0130 KAYIT \u0130\xC7\u0130N UYGUN"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058446
    m_Localized: "Bu kay\u0131t mevcut oyun s\xFCr\xFCm\xFCyle uyumlu."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058447
    m_Localized: "Ana kay\u0131t kullan\u0131lam\u0131yor. Uyumlu kurtarma kopyas\u0131
      kullan\u0131lacak."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058448
    m_Localized: "Bu kay\u0131t uyumsuz bir oyun s\xFCr\xFCm\xFCyle olu\u015Fturulmu\u015F."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058449
    m_Localized: "Kay\u0131t var ancak i\xE7eri\u011Fi ge\xE7erli de\u011Fil."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058450
    m_Localized: "Bu yuvaya hen\xFCz bir sefer kayd\u0131 yaz\u0131lmad\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058451
    m_Localized: "KAYDIN \xDCZER\u0130NE YAZ"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058452
    m_Localized: "Bu yuvadaki mevcut kay\u0131t de\u011Fi\u015Ftirilecek."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058453
    m_Localized: "\xDCZER\u0130NE YAZ"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058454
    m_Localized: "KAYDI S\u0130L"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058455
    m_Localized: "Bu kay\u0131t ve kurtarma yede\u011Fi kal\u0131c\u0131 olarak silinecek."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058456
    m_Localized: "Kaydetme ba\u015Far\u0131s\u0131z: {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058457
    m_Localized: Oyun kaydedildi.
    m_Metadata:
      m_Items: []
  - m_Id: 1264058458
    m_Localized: "Silme ba\u015Far\u0131s\u0131z: {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058459
    m_Localized: "Kay\u0131t silindi."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058460
    m_Localized: "Onay ekran\u0131 kullan\u0131lam\u0131yor."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058461
    m_Localized: HAZIR
    m_Metadata:
      m_Items: []
  - m_Id: 1264058462
    m_Localized: EYLEM KULLANILAMIYOR
    m_Metadata:
      m_Items: []
  - m_Id: 1264058463
    m_Localized: TAMAMLANDI
    m_Metadata:
      m_Items: []
  - m_Id: 1264058464
    m_Localized: YOK
    m_Metadata:
      m_Items: []
  - m_Id: 1264058465
    m_Localized: "AKTARIM Y\xD6N\xDC DE\u011E\u0130\u015ET\u0130R\u0130LD\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058466
    m_Localized: "E\u015EYA SE\xC7\u0130LMED\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058467
    m_Localized: '{0} {1} AKTARILDI'
    m_Metadata:
      m_Items: []
  - m_Id: 1264058468
    m_Localized: "AKTARIM BA\u015EARISIZ"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058469
    m_Localized: "Aktar\u0131m tamamlanamad\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058470
    m_Localized: KARGO AKTARIMI
    m_Metadata:
      m_Items: []
  - m_Id: 1264058471
    m_Localized: "B\u0130R E\u015EYA SE\xC7 VE AKTAR"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058472
    m_Localized: "TAR\u0130F SE\xC7\u0130LMED\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058473
    m_Localized: "\u0130STASYON HAZIR DE\u011E\u0130L"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058474
    m_Localized: "{0} \xDCRET\u0130LD\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058475
    m_Localized: "\xDCRET\u0130M BA\u015EARISIZ"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058476
    m_Localized: "Tarif \xFCretilemedi."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058477
    m_Localized: "{0} TERM\u0130NAL\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058478
    m_Localized: "\xDCRET\u0130M TERM\u0130NAL\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058479
    m_Localized: "TAR\u0130F YOK"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058480
    m_Localized: "Bu istasyonda kullan\u0131labilir tarif yok."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058481
    m_Localized: "KULLANILAB\u0130L\u0130R TAR\u0130F YOK"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058482
    m_Localized: "G\u0130RD\u0130LER"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058483
    m_Localized: "\xC7IKTILAR"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058484
    m_Localized: "ARA\u015ETIRMA SE\xC7\u0130LMED\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058485
    m_Localized: '{0} TAMAMLANDI'
    m_Metadata:
      m_Items: []
  - m_Id: 1264058486
    m_Localized: "ARA\u015ETIRMA BA\u015EARISIZ"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058487
    m_Localized: "Ara\u015Ft\u0131rma tamamlanamad\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058488
    m_Localized: "ARA\u015ETIRMA TERM\u0130NAL\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058489
    m_Localized: "ARA\u015ETIRMA YOK"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058490
    m_Localized: "Bu terminalde kullan\u0131labilir ara\u015Ft\u0131rma yok."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058491
    m_Localized: "KULLANILAB\u0130L\u0130R ARA\u015ETIRMA YOK"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058492
    m_Localized: "{0}  /  SEV\u0130YE {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058493
    m_Localized: "GEREKL\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058494
    m_Localized: "\u015EEMALAR"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058495
    m_Localized: YETENEKLER
    m_Metadata:
      m_Items: []
  - m_Id: 1264058496
    m_Localized: "\xDCretim Terminalini A\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058497
    m_Localized: "Ara\u015Ft\u0131rma Terminalini A\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058498
    m_Localized: "Kargo Aktar\u0131m\u0131n\u0131 A\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058499
    m_Localized: "GER\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058500
    m_Localized: Terminali kapat
    m_Metadata:
      m_Items: []
  - m_Id: 1264058501
    m_Localized: "\xDCRET"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058502
    m_Localized: "Se\xE7ili malzemeleri kullan"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058503
    m_Localized: TAMAMLA
    m_Metadata:
      m_Items: []
  - m_Id: 1264058504
    m_Localized: "Gereksinimleri harca ve kilidi a\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058505
    m_Localized: "B\u0130R ADET AKTAR"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058506
    m_Localized: "Bir birim ta\u015F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058507
    m_Localized: "YI\u011EINI AKTAR"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058508
    m_Localized: "Se\xE7ili y\u0131\u011F\u0131n\u0131 ta\u015F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058509
    m_Localized: "Y\xD6N\xDC DE\u011E\u0130\u015ET\u0130R"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058510
    m_Localized: "Aktar\u0131m y\xF6n\xFCn\xFC tersine \xE7evir"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058511
    m_Localized: SES
    m_Metadata:
      m_Items: []
  - m_Id: 1264058512
    m_Localized: Ana ses
    m_Metadata:
      m_Items: []
  - m_Id: 1264058513
    m_Localized: "Oyunun t\xFCm ses kar\u0131\u015F\u0131m\u0131n\u0131 kontrol et."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058514
    m_Localized: "M\xFCzik"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058515
    m_Localized: "Adaptif m\xFCzik seviyesini kontrol et."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058516
    m_Localized: Ortam sesi
    m_Metadata:
      m_Items: []
  - m_Id: 1264058517
    m_Localized: "Uzay, atmosfer ve i\xE7 mek\xE2n ortam seslerini kontrol et."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058518
    m_Localized: Efektler
    m_Metadata:
      m_Items: []
  - m_Id: 1264058519
    m_Localized: "Uzay arac\u0131 ve d\xFCnya ses efektlerini kontrol et."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058520
    m_Localized: "Aray\xFCz sesi"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058521
    m_Localized: "Aray\xFCz gezinme ve geri bildirim seslerini kontrol et."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058523
    m_Localized: "\u0130N\u0130\u015E VEKT\xD6R\xDC"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058524
    m_Localized: YAKIT
    m_Metadata:
      m_Items: []
  - m_Id: 1264058525
    m_Localized: "Arkada\u015Fa kat\u0131l"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058527
    m_Localized: "G\xD6R\xDCNT\xDC"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058528
    m_Localized: Ekran modu
    m_Metadata:
      m_Items: []
  - m_Id: 1264058529
    m_Localized: "Tam ekran, kenarl\u0131ks\u0131z tam ekran veya standart pencere
      aras\u0131nda se\xE7im yap."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058530
    m_Localized: "Pencere \xE7\xF6z\xFCn\xFCrl\xFC\u011F\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058531
    m_Localized: "Ekran\u0131n\u0131n bildirdi\u011Fi \xE7\xF6z\xFCn\xFCrl\xFCkler
      aras\u0131ndan se\xE7."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058532
    m_Localized: "Dikey e\u015Fitleme"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058533
    m_Localized: "Ekran y\u0131rt\u0131lmas\u0131n\u0131 azaltmak i\xE7in kareleri
      monit\xF6r yenileme h\u0131z\u0131yla e\u015Fitle."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058534
    m_Localized: "Kenarl\u0131ks\u0131z tam ekran"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058535
    m_Localized: Pencereli
    m_Metadata:
      m_Items: []
  - m_Id: 1264058536
    m_Localized: UYGULA
    m_Metadata:
      m_Items: []
  - m_Id: 1264058537
    m_Localized: "MASA\xDCST\xDCNE \xC7IK"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058538
    m_Localized: "ANA MEN\xDCYE D\xD6N"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058539
    m_Localized: "D\xD6N"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058540
    m_Localized: "Kaydedilmemi\u015F ilerleme kaybolabilir."
    m_Metadata:
      m_Items: []
  - m_Id: 1264058541
    m_Localized: Tam ekran
    m_Metadata:
      m_Items: []
  - m_Id: 1264058542
    m_Localized: "Yenileme h\u0131z\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 1264058543
    m_Localized: "Yaln\u0131zca tam ekran modunda ge\xE7erlidir."
    m_Metadata:
      m_Items: []
  - m_Id: 7915893880782848
    m_Localized: KATIL
    m_Metadata:
      m_Items: []
  - m_Id: 7915893880782849
    m_Localized: "Arkada\u015Fa Kat\u0131l"
    m_Metadata:
      m_Items: []
  - m_Id: 7915893880782850
    m_Localized: "Sunucu adresi, \xF6rne\u011Fin 192.168.1.20"
    m_Metadata:
      m_Items: []
  - m_Id: 7915893880782851
    m_Localized: "Sunucuya ba\u011Flan\u0131l\u0131yor..."
    m_Metadata:
      m_Items: []
  - m_Id: 7915893880782852
    m_Localized: "Ortak oyun oturumu ba\u015Flat\u0131l\u0131yor..."
    m_Metadata:
      m_Items: []
  - m_Id: 7915893880782853
    m_Localized: "Ge\xE7erli bir sunucu adresi girin."
    m_Metadata:
      m_Items: []
  - m_Id: 7915893880782854
    m_Localized: "Sunucuya ula\u015F\u0131lamad\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 7915893880782855
    m_Localized: "Sunucu farkl\u0131 bir oyun s\xFCr\xFCm\xFC \xE7al\u0131\u015Ft\u0131r\u0131yor."
    m_Metadata:
      m_Items: []
  - m_Id: 7915893880782856
    m_Localized: "Ortak oyun oturumu olu\u015Fturulamad\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 7938836249706496
    m_Localized: "Sunucu oturumu sonland\u0131rd\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 7949909262598144
    m_Localized: "Steam lobisi olu\u015Fturulamad\u0131; arkada\u015Flar davetle
      kat\u0131lamaz."
    m_Metadata:
      m_Items: []
  - m_Id: 7949909262598145
    m_Localized: "ORTAK OYUN KAYDED\u0130LD\u0130."
    m_Metadata:
      m_Items: []
  - m_Id: 7949909262598146
    m_Localized: "ORTAK OYUN KAYDED\u0130LEMED\u0130."
    m_Metadata:
      m_Items: []
  - m_Id: 7964775574667265
    m_Localized: GAZ
    m_Metadata:
      m_Items: []
  - m_Id: 8230580786823168
    m_Localized: "Oyun ba\u015Flat\u0131lamad\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 8230580786823169
    m_Localized: "Bu ekran hen\xFCz kullan\u0131lam\u0131yor."
    m_Metadata:
      m_Items: []
  - m_Id: 8244035849814016
    m_Localized: "Ba\u015Flat"
    m_Metadata:
      m_Items: []
  - m_Id: 8244035891757056
    m_Localized: "Ortak oyuna a\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 8244035891757057
    m_Localized: "YEN\u0130 SEFER"
    m_Metadata:
      m_Items: []
  - m_Id: 8244035891757058
    m_Localized: "YEN\u0130 OYUN"
    m_Metadata:
      m_Items: []
  - m_Id: 8244035891757059
    m_Localized: "Yeni seferin kaydedilece\u011Fi yuvay\u0131 se\xE7."
    m_Metadata:
      m_Items: []
  - m_Id: 8332064127975424
    m_Localized: "Adres panoya kopyaland\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 8332064220250112
    m_Localized: "Bu adresi yerel a\u011F\u0131n\u0131zda payla\u015F\u0131n. \u0130nternet
      \xFCzerinden oynamak i\xE7in sunucu y\xF6nlendiricisinde 7770 portu a\xE7\u0131lmal\u0131d\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 8332064220250113
    m_Localized: "ADRES\u0130 KOPYALA"
    m_Metadata:
      m_Items: []
  - m_Id: 8332064224444416
    m_Localized: Sunucu oturumu dolu.
    m_Metadata:
      m_Items: []
  - m_Id: 8332064224444417
    m_Localized: "ARKADA\u015E DAVET ET"
    m_Metadata:
      m_Items: []
  - m_Id: 8332064224444418
    m_Localized: "Ba\u011Fl\u0131 ba\u015Fka k\xE2\u015Fif yok."
    m_Metadata:
      m_Items: []
  - m_Id: 8332064224444419
    m_Localized: (sen)
    m_Metadata:
      m_Items: []
  - m_Id: 8332064224444420
    m_Localized: "Bir co-op oturumu zaten ba\u015Flat\u0131l\u0131yor."
    m_Metadata:
      m_Items: []
  - m_Id: 8332064224444421
    m_Localized: "{0} ile \xE7ak\u0131\u015F\u0131yor. De\u011Fi\u015Fiklik geri
      al\u0131nd\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 8332064224444422
    m_Localized: "Yeniden atamak i\xE7in bir kontrol se\xE7in. Escape iptal eder."
    m_Metadata:
      m_Items: []
  - m_Id: 8332064224444423
    m_Localized: "B\u0130R TU\u015EA BASIN"
    m_Metadata:
      m_Items: []
  - m_Id: 8332064224444424
    m_Localized: "Kontroller varsay\u0131lanlar\u0131na d\xF6nd\xFCr\xFCld\xFC."
    m_Metadata:
      m_Items: []
  - m_Id: 8332064224444425
    m_Localized: "ATANMAMI\u015E"
    m_Metadata:
      m_Items: []
  - m_Id: 8332064224444426
    m_Localized: "\xD6nceki ekran ayarlar\u0131na {0} saniye i\xE7inde d\xF6n\xFClecek."
    m_Metadata:
      m_Items: []
  - m_Id: 8332064224444427
    m_Localized: KORU
    m_Metadata:
      m_Items: []
  - m_Id: 8332064224444428
    m_Localized: "GER\u0130 AL"
    m_Metadata:
      m_Items: []
  - m_Id: 8332064224444429
    m_Localized: "Bu ekran ayarlar\u0131 korunsun mu?"
    m_Metadata:
      m_Items: []
  - m_Id: 8332064224444430
    m_Localized: "Kamera g\xF6r\xFC\u015F a\xE7\u0131s\u0131n\u0131 geni\u015Fletin
      veya daralt\u0131n."
    m_Metadata:
      m_Items: []
  - m_Id: 8332064224444431
    m_Localized: "G\xF6r\xFC\u015F a\xE7\u0131s\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 8332064224444432
    m_Localized: "Yaya ve u\xE7u\u015Fta dikey bak\u0131\u015F eksenini ters \xE7evirin."
    m_Metadata:
      m_Items: []
  - m_Id: 8332064224444433
    m_Localized: "Bak\u0131\u015F\u0131 ters \xE7evir"
    m_Metadata:
      m_Items: []
  - m_Id: 8332064224444434
    m_Localized: "Belirli bir fare hareketinde g\xF6r\xFC\u015F\xFCn ne kadar d\xF6nece\u011Fini
      \xF6l\xE7ekleyin."
    m_Metadata:
      m_Items: []
  - m_Id: 8332064224444435
    m_Localized: Fare hassasiyeti
    m_Metadata:
      m_Items: []
  - m_Id: 8332064224444436
    m_Localized: "T\xFCm kontrolleri varsay\u0131lan tu\u015Funa d\xF6nd\xFCr\xFCn."
    m_Metadata:
      m_Items: []
  - m_Id: 8332064224444437
    m_Localized: "Kontrolleri s\u0131f\u0131rla"
    m_Metadata:
      m_Items: []
  - m_Id: 8332064224444438
    m_Localized: KONTROLLER
    m_Metadata:
      m_Items: []
  - m_Id: 8349379842277376
    m_Localized: Kontrol kaydedildi.
    m_Metadata:
      m_Items: []
  - m_Id: 8349379880026112
    m_Localized: OTURUM
    m_Metadata:
      m_Items: []
  - m_Id: 8380430157348864
    m_Localized: "\u0130leri"
    m_Metadata:
      m_Items: []
  - m_Id: 8380430224457728
    m_Localized: Geri
    m_Metadata:
      m_Items: []
  - m_Id: 8380430224457729
    m_Localized: Sola
    m_Metadata:
      m_Items: []
  - m_Id: 8380430224457730
    m_Localized: "Sa\u011Fa"
    m_Metadata:
      m_Items: []
  - m_Id: 8380430224457731
    m_Localized: "Z\u0131pla"
    m_Metadata:
      m_Items: []
  - m_Id: 8380430224457732
    m_Localized: "Ko\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 8380430224457733
    m_Localized: "Etkile\u015Fim"
    m_Metadata:
      m_Items: []
  - m_Id: 8380430224457734
    m_Localized: "\u0130leri itki"
    m_Metadata:
      m_Items: []
  - m_Id: 8380430224457735
    m_Localized: Geri itki
    m_Metadata:
      m_Items: []
  - m_Id: 8380430224457736
    m_Localized: Sola kayma
    m_Metadata:
      m_Items: []
  - m_Id: 8380430224457737
    m_Localized: "Sa\u011Fa kayma"
    m_Metadata:
      m_Items: []
  - m_Id: 8380430224457738
    m_Localized: "Al\xE7al"
    m_Metadata:
      m_Items: []
  - m_Id: 8380430224457739
    m_Localized: "Y\xFCksel"
    m_Metadata:
      m_Items: []
  - m_Id: 8380430224457740
    m_Localized: "Sola yat\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 8380430224457741
    m_Localized: "Sa\u011Fa yat\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 8380430224457742
    m_Localized: "H\u0131zlan"
    m_Metadata:
      m_Items: []
  - m_Id: 8380430224457743
    m_Localized: Fren
    m_Metadata:
      m_Items: []
  - m_Id: 8380430224457744
    m_Localized: "U\xE7u\u015F deste\u011Fi"
    m_Metadata:
      m_Items: []
  - m_Id: 8380430224457745
    m_Localized: "\u0130ni\u015F tak\u0131m\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 8380430224457746
    m_Localized: "Ara\xE7tan in"
    m_Metadata:
      m_Items: []
  - m_Id: 8380430224457747
    m_Localized: "Kamera g\xF6r\xFCn\xFCm\xFC"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
